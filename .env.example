# Canonical site URL (SEO, sitemap, Open Graph). On Vercel the production URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://daiso.mn

# -- erxes API (server only) --------------------------------------------------
# Website orders (POST /api/orders) -> erxes form submissions -> sales card
ERXES_API_URL=                # https://<subdomain>.next.erxes.io/gateway
ERXES_ORDER_FORM_ID=          # erxes form _id that receives website orders
ERXES_ORDER_FIELD_IDS=        # {"name":"<fieldId>","phone":"<fieldId>","email":"<fieldId>","message":"<fieldId>"}
# Client Portal token (x-app-token), server only: used by the price sync (npm run sync:erxes).
ERXES_APP_TOKEN=
